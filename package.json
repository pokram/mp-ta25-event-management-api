{
    "name": "event-management-api",
    "version": "0.1.0",
    "description": "Ürituste ja piletimüügi REST API (Node.js, TypeScript, Express, PostgreSQL).",
    "type": "module",
    "scripts": {
        "server": "tsx --env-file=.env src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "express": "^5.3.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "oxlint": "^1.94.0",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    }
}
